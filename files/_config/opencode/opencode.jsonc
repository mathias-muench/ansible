{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": {
      "~/Downloads/*": "allow",
      "~/src/*": "allow",
      "~/.config/opencode/*": "allow",
    },
  },
  "formatter": {
    "prettier": {
      "command": ["prettier", "--prose-wrap always", "--write", "$FILE"],
    },
  },
}
