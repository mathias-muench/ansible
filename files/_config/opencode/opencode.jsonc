{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-reminders"],
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
      },
      "models": {
        "local": {
          "name": "local",
          "contextSize": 32768,
        },
      },
    },
  },
}
